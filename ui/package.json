{
  "name": "mads-ui",
  "private": true,
  "version": "0.1.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "gallery": "vite --open /gallery.html",
    "conversation": "vite --open /conversation.html",
    "files": "vite --open /files.html",
    "pipeline": "vite --open /pipeline.html",
    "build": "tsc --noEmit -p tsconfig.json && vite build && tsc -p electron/tsconfig.json",
    "start": "npm run build && electron .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:pty": "vitest run --config vitest.electron.config.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "^3.2.3",
    "marked": "^15.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "happy-dom": "^15.11.7",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "node-pty@1.1.0": true
  }
}
