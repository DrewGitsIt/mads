{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "../dist-electron",
    "composite": false,
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["./**/*.ts"],
  // Tests are type-checked by tsconfig.test.json but must not ship.
  "exclude": ["./**/*.test.ts", "./**/*.realtest.ts"]
}
